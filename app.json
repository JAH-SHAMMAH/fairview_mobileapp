{
  "expo": {
    "name": "Fairview Portal",
    "slug": "fairview-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.extracare.fairviewportal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E3B2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.extracare.fairviewportal"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "fairview",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0E3B2C",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0E3B2C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fairview needs your photos so you can attach a picture of your work as an exam answer.",
          "cameraPermission": "Fairview needs the camera so you can take a photo of your work as an exam answer.",
          "microphonePermission": false
        }
      ]
    ],
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
